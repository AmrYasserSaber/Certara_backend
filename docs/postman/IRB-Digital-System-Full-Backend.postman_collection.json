                "value": "IRB_ACCESS_TOKEN={{accessToken}}; IRB_REFRESH_TOKEN={{refreshToken}}; IRB_CSRF_TOKEN={{csrfToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/manager/research/{{researchId}}/certificate"
          }
        }
      ]
    },
    {
      "name": "06 - Certificates (Shared Access)",
      "item": [
        {
          "name": "GET /api/research/{id}/certificate",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/pdf" },
              {
                "key": "Cookie",
                "value": "IRB_ACCESS_TOKEN={{accessToken}}; IRB_REFRESH_TOKEN={{refreshToken}}; IRB_CSRF_TOKEN={{csrfToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/research/{{researchId}}/certificate",
            "description": "Allowed roles: admin, manager, student (student can only download own research certificate)"
          }
        }
      ]
    }
  ]
}
