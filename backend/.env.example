# Application
APP_NAME="IRB Digital System"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Africa/Cairo
APP_LOCALE=ar
LOG_LEVEL=debug
LOG_TO_STDERR=true

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Cookies (required for cross-site frontend + cookie auth)
# For cross-site cookies, browsers require SameSite=None AND Secure=true (HTTPS).
COOKIE_SAMESITE=None
COOKIE_SECURE=true

# Database
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=irb_system
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# JWT
JWT_SECRET=change-me-to-a-long-random-secret
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=1209600
JWT_ISSUER=irb-system
JWT_ALGO=HS256

# Uploads
UPLOAD_MAX_MB=10
UPLOAD_DOCUMENTS_DIR=uploads/documents
UPLOAD_CERTIFICATES_DIR=uploads/certificates

# ImageKit
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=
IMAGEKIT_FOLDER_ROOT=/irb
IMAGEKIT_USE_UNIQUE_FILE_NAME=true
IMAGEKIT_SIGNED_URL_EXPIRE_SECONDS=300

# Mail (PHPMailer / SMTP)
MAIL_DRIVER=log
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@irb.local
MAIL_FROM_NAME="IRB System"

# SMS
SMS_DRIVER=log
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=IRB
