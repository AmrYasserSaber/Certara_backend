{
  "info": {
    "_postman_id": "8e3a0f41-5c6b-4e7a-9d1f-4f2d3c6b7a8e",
    "name": "IRB Digital System - Full Backend",
    "description": "Complete backend Postman collection for all routed endpoints in Certara backend.\n\nAuth model:\n- Login sets cookies (IRB_ACCESS_TOKEN, IRB_REFRESH_TOKEN, IRB_CSRF_TOKEN)\n- Protected endpoints use Cookie header from environment vars\n- State-changing endpoints require X-CSRF-Token header\n\nQuick flow:\n1) Health\n2) Auth > Login (Admin/Manager/Student)\n3) Call protected endpoints\n4) Use Role Switch requests to log in as each role\n\nResponse envelope:\n{ success, data, error, meta }",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.environment.get('baseUrl')) pm.environment.set('baseUrl', 'http://localhost:8000');",
          "if (!pm.environment.get('researchId')) pm.environment.set('researchId', '104');",
          "if (!pm.environment.get('userId')) pm.environment.set('userId', '5');",
          "if (!pm.environment.get('reviewerId')) pm.environment.set('reviewerId', '4');",
          "if (!pm.environment.get('notificationId')) pm.environment.set('notificationId', '1');"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test('Envelope has success field', function () {",
          "  const ct = pm.response.headers.get('Content-Type') || '';",
          "  if (ct.includes('application/json')) {",
          "    const body = pm.response.json();",
          "    pm.expect(body).to.have.property('success');",
          "  }",
          "});"
        ]
      }
    }
  ],
