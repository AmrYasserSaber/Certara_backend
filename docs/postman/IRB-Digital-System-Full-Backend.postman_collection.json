        {
          "name": "PUT /api/admin/users/{id}/reject",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const configuredId = (pm.environment.get('userId') || '').trim();",
                  "if (configuredId) {",
                  "  console.log('Using configured userId for reject:', configuredId);",
                  "} else {",
                  "  const cookieHeader = `IRB_ACCESS_TOKEN=${pm.environment.get('accessToken') || ''}; IRB_REFRESH_TOKEN=${pm.environment.get('refreshToken') || ''}; IRB_CSRF_TOKEN=${pm.environment.get('csrfToken') || ''}`;",
                  "  pm.sendRequest({",
                  "    url: `${pm.environment.get('baseUrl')}/api/admin/users/pending?page=1&limit=20&status=pending`,",
                  "    method: 'GET',",
                  "    header: {",
                  "      'Accept': 'application/json',",
                  "      'Cookie': cookieHeader",
                  "    }",
                  "  }, function (err, res) {",
                  "    if (err) {",
                  "      console.log('Failed to auto-load pending users before reject', err);",
                  "      return;",
                  "    }",
                  "    let body = null;",
                  "    try { body = res.json(); } catch (e) { body = null; }",
                  "    const firstPendingId = body?.data?.items?.[0]?.id;",
                  "    if (firstPendingId) {",
                  "      pm.environment.set('userId', String(firstPendingId));",
                  "      console.log('Auto-selected pending userId for reject:', firstPendingId);",
                  "    } else {",
                  "      console.log('No pending user found to auto-select for reject request');",
                  "    }",
                  "  });",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Reject request returns success', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.success).to.eql(true);",
                  "  pm.expect(body.data).to.have.property('user');",
                  "  pm.expect(body.data.user).to.have.property('status', 'rejected');",
                  "});",
                  "try {",
                  "  const body = pm.response.json();",
                  "  const rejectedId = body?.data?.user?.id;",
                  "  if (rejectedId) pm.environment.set('userId', String(rejectedId));",
                  "} catch (e) {}"
                ]
              }
            }
          ],
          "request": {
